<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.systurismo.controller.LoginController"
      alignment="CENTER" spacing="14" prefWidth="440" prefHeight="350"
      style="-fx-background-color:#f4f7fb;">
    <padding><Insets top="25" right="35" bottom="25" left="35"/></padding>
    <Label text="SysTurismo" style="-fx-font-size:29px;-fx-font-weight:bold;-fx-text-fill:#164b78;"/>
    <Label text="Sistema de Agencia de Turismo"/>
    <GridPane hgap="10" vgap="12">
        <Label text="Usuario" GridPane.rowIndex="0"/>

        <TextField fx:id="txtUsuario"
                   promptText="Ingrese su usuario"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Contraseña" GridPane.rowIndex="1"/>

        <PasswordField fx:id="txtClave"
                       promptText="Ingrese su contraseña"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"
                       onAction="#ingresar"/>

    </GridPane>
    <HBox spacing="12">
        <Button text="Ingresar" onAction="#ingresar" defaultButton="true"/>
        <Button text="Salir" onAction="#salir"/>
    </HBox>
    <Label text="Acceso inicial: admin / admin123"
           style="-fx-font-size:11px;-fx-text-fill:#666;"/>
</VBox>
